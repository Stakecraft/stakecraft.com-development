# Dev / Cloudflare Pages preview (recommended for stakecraft-com-development):
VITE_API_BASE_URL=https://backend.dev.stakecraft.com/api

# Production:
# VITE_API_BASE_URL=https://backend.stakecraft.com/api

# Local backend:
# VITE_API_BASE_URL=http://localhost:5000/api

# Do NOT use frontend hosts here (dev.stakecraft.com, stakecraft.com, *.pages.dev).

# Solana RPC (optional — defaults to public mainnet-beta endpoint)
# VITE_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# VITE_HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Environment identifier (development/production)
VITE_ENV=
