# ---------------------------------------------------------------------------
# StakeCraft frontend configuration
#
# WARNING: every VITE_ variable is inlined into the production JavaScript
# bundle at build time. Anything placed here is PUBLIC and readable by any
# visitor via devtools. Never put an API secret, private key or password in
# this file - put it in the backend .env instead.
# ---------------------------------------------------------------------------

# Base URL of the StakeCraft API.
#   Development: http://localhost:5000/api
#   Production:  https://backend.stakecraft.com/api
VITE_API_BASE_URL=

# Environment identifier (development/production)
VITE_ENV=

# ---------------------------------------------------------------------------
# Pinata / IPFS credentials are deliberately NOT here.
#
# They previously lived in this file as VITE_PINATA_API_KEY and
# VITE_PINATA_SECRET_KEY, which published them to every visitor. Image uploads
# now go to POST /api/upload/ipfs and the server holds the credentials.
# Configure PINATA_JWT (or PINATA_API_KEY / PINATA_SECRET_KEY) in the backend.
# ---------------------------------------------------------------------------
