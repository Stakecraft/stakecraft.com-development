# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/stakecraft

# JWT Configuration — REQUIRED in production
JWT_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
# Comma-separated extra allowed origins (Cloudflare preview URLs, etc.)
# Local Vite origins (localhost / 127.0.0.1 :5173/:4173) are always allowed.
# CORS_EXTRA_ORIGINS=https://5dc70aa8.stakecraft-com-development.pages.dev

# Pinata IPFS (server-side only — never expose in frontend)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
