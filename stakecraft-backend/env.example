# ---------------------------------------------------------------------------
# StakeCraft backend configuration
#
# Copy to .env.development or .env.production. Both files are gitignored.
# The server validates this file at startup and refuses to boot if a required
# secret is missing or left at a placeholder value.
# ---------------------------------------------------------------------------

# Server Configuration
# PORT: Port the server will run on (default: 5000)
# NODE_ENV: development or production
PORT=5000
NODE_ENV=development

# Database Configuration
# Use a SEPARATE database for development. Pointing a dev server at the
# production cluster means test writes and seed scripts hit live data.
#   Development: mongodb://127.0.0.1:27017/stakecraft_dev
#   Production:  your MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/stakecraft_dev

# ---------------------------------------------------------------------------
# JWT Configuration - REQUIRED IN PRODUCTION
#
# Generate with:  openssl rand -base64 48
#
# Must be at least 32 characters and must not be a placeholder. Every admin
# session is signed with this value: if it is guessable or shared, anyone can
# mint a valid admin token and the authentication layer is decorative.
# Rotating it immediately invalidates all existing sessions.
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend URL (for CORS)
#   Development: http://localhost:5173
#   Production:  https://stakecraft.com
FRONTEND_URL=http://localhost:5173

# Additional allowed CORS origins, comma-separated (optional)
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Pinata / IPFS - server side only.
#
# These moved off the frontend. Anything exposed to Vite with a VITE_ prefix
# is compiled into the JavaScript bundle and readable by every visitor, so an
# API secret can never live there. The browser now uploads to
# POST /api/upload/ipfs and the server forwards the file to Pinata.
#
# Supply either PINATA_JWT, or the legacy key/secret pair.
# ---------------------------------------------------------------------------
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_KEY=

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ---------------------------------------------------------------------------
# Bootstrap
#
# Leave false. The public POST /api/auth/setup route stays disabled and
# returns 404; create administrators with `npm run create-admin` instead,
# which runs on the server and is not reachable from the internet.
# ---------------------------------------------------------------------------
ALLOW_PUBLIC_SETUP=false

# Set to "true" only for local load testing. Never in production.
DISABLE_RATE_LIMIT=false
